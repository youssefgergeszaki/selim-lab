# SELIM LAB — environment variables
# Copy to .env.local for local development. In Vercel, set them under
# Project → Settings → Environment Variables (separately for Production and Preview).
# NEVER commit real values.

# ---------------------------------------------------------------------------
# PUBLIC (exposed to the browser — safe to share)
# ---------------------------------------------------------------------------
# Canonical site URL, no trailing slash. Used for canonical/hreflang URLs, the sitemap,
# auth email links and Paymob callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (or Connect).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (legacy) key or the publishable key (sb_publishable_...). RLS protects all data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# SERVER-ONLY (secrets — never prefix with NEXT_PUBLIC_, never expose to the browser)
# ---------------------------------------------------------------------------
# The service_role key (legacy) or a secret key (sb_secret_...). Bypasses RLS: used only by
# server code after authorization checks (checkout, webhooks, dashboard).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Random string (32+ chars). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-a-long-random-string

# --- Paymob (Egypt) — Unified Checkout / Intention API ----------------------
# Paymob dashboard → Settings → Account Info. Use TEST keys until you go live.
PAYMOB_SECRET_KEY=egy_sk_test_xxx
# Public key (egy_pk_...). Not secret, but only used server-side to build the checkout URL.
PAYMOB_PUBLIC_KEY=egy_pk_test_xxx
# HMAC secret used to verify transaction callbacks.
PAYMOB_HMAC_SECRET=xxx
# Online card payment integration ID (Paymob dashboard → Developers → Payment Integrations).
PAYMOB_INTEGRATION_ID=0000000
# Optional: mobile wallet integration ID (leave empty to keep wallets unavailable).
PAYMOB_WALLET_INTEGRATION_ID=
# Optional but recommended: legacy API key, enables server-side transaction confirmation
# (GET /api/acceptance/transactions/{id}) for defence in depth.
PAYMOB_API_KEY=

# Optional overrides (defaults shown). Only change if Paymob instructs you to.
# PAYMOB_API_BASE_URL=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/

# ---------------------------------------------------------------------------
# TESTS ONLY (never set in Vercel)
# ---------------------------------------------------------------------------
# PostgreSQL server used by `npm run test:db` (creates and drops throwaway databases).
# With the Supabase CLI running locally: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# TEST_DATABASE_URL=
